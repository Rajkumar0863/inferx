*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.pdb

# ----------------------------
# Visual Studio
# ----------------------------
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# ----------------------------
# Visual Studio Code
# ----------------------------
.vscode/

# ----------------------------
# JetBrains IDEs
# ----------------------------
.idea/

# ----------------------------
